# Copy this file to .env for local development.
# Never commit real secrets.

GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=rotate-and-fill-your-google-oauth-client-secret
GOOGLE_ALLOWED_DOMAIN=ucdavis.edu

# Local development should stay on development so HTTP localhost login keeps sessions.
APP_ENV=development
TRUST_PROXY=0
WEB_HOST=127.0.0.1
WEB_PORT=5050

SECRET_KEY=generate-a-long-random-secret
APP_ENCRYPTION_KEY=generate-another-long-random-secret

# Platform LLM fallback. Users with their own API key bypass this quota.
PLATFORM_DAILY_CHAT_LIMIT=15
LLM_API_KEY=your-platform-llm-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
